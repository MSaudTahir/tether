<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tether.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tether"
    Title="Tether">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: drag area, plus the toolbar buttons -->
        <Grid x:Name="TitleBar" Padding="16,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/icon.png" Width="18" Height="18" />
                <TextBlock Text="Tether" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="Toolbar" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="UpdateButton" Visibility="Collapsed" Click="Update_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Click="Pair_Click" ToolTipService.ToolTip="Pair over Wi-Fi">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE701;" FontSize="14" />
                        <TextBlock Text="Pair" />
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Click="Refresh_Click" ToolTipService.ToolTip="Reload device info and the app list (Ctrl+R)">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Click="Settings_Click" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <local:SetupView x:Name="Setup" Grid.Row="1" Visibility="Collapsed" />

        <Grid x:Name="Main" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Devices -->
            <StackPanel Padding="8,4,8,8" Spacing="4">
                <TextBlock Text="Devices" Margin="12,4,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView x:Name="DeviceList" SelectionMode="Single" SelectionChanged="DeviceList_SelectionChanged" />
            </StackPanel>

            <!-- Detail -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <Grid>
                    <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
                        <FontIcon x:Name="EmptyIcon" Glyph="&#xE8EA;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="EmptyTitle" Text="No Devices" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Plug in a phone with USB debugging on, or pair one over Wi-Fi." />
                        <Button x:Name="EmptyPair" Content="Pair over Wi-Fi…" HorizontalAlignment="Center" Click="Pair_Click" />
                    </StackPanel>

                    <ScrollViewer x:Name="Detail" Visibility="Collapsed" AllowDrop="True" DragOver="Detail_DragOver" Drop="Detail_Drop">
                        <StackPanel Padding="28" Spacing="28">
                            <!-- Device header card -->
                            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="DeviceName" Style="{StaticResource TitleLargeTextBlockStyle}" />
                                    <TextBlock x:Name="DeviceSubtitle" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel x:Name="Pills" Orientation="Horizontal" Spacing="8" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                        <Button x:Name="MirrorButton" Style="{StaticResource AccentButtonStyle}" Click="Mirror_Click"
                                                ToolTipService.ToolTip="Mirror the phone's screen (Ctrl+Shift+M)">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                                                <TextBlock Text="Mirror Screen" />
                                            </StackPanel>
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Modifiers="Control,Shift" Key="M" />
                                            </Button.KeyboardAccelerators>
                                        </Button>
                                        <Button x:Name="WirelessButton" Click="Wireless_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE701;" FontSize="16" />
                                                <TextBlock Text="Go Wireless" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleButton x:Name="CaptureMouse" Click="CaptureMouse_Click"
                                                      ToolTipService.ToolTip="Use the mouse like a real one on the phone (for games and apps that capture the pointer). Press Left Alt to release it.">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE962;" FontSize="16" />
                                                <TextBlock Text="Capture Mouse" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ContentControl x:Name="ControlsHost" HorizontalContentAlignment="Stretch" />
                            <ContentControl x:Name="DetailsHost" HorizontalContentAlignment="Stretch" />
                            <ContentControl x:Name="NotificationsHost" HorizontalContentAlignment="Stretch" />

                            <!-- Apps -->
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="Apps" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="AppCount" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <AutoSuggestBox x:Name="Search" Grid.Column="2" Width="220" PlaceholderText="Filter apps" QueryIcon="Find"
                                                    TextChanged="Search_TextChanged" />
                                    <DropDownButton x:Name="WindowSizeButton" Grid.Column="3" ToolTipService.ToolTip="Size of the virtual display apps open on" />
                                </Grid>
                                <TextBlock x:Name="AppsHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressRing x:Name="AppsLoading" IsActive="False" Width="32" Height="32" Margin="0,60" />
                                <StackPanel x:Name="AppsError" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40">
                                    <TextBlock Text="Couldn't List Apps" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="AppsErrorText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="Try Again" HorizontalAlignment="Center" Click="Refresh_Click" />
                                </StackPanel>
                                <GridView x:Name="AppGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
