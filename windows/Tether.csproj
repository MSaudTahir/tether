<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Tether</RootNamespace>
    <AssemblyName>Tether</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Tether.ico</ApplicationIcon>
    <Platforms>ARM64;x64</Platforms>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- A plain folder with Tether.exe: no MSIX, no runtime installs. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Still needed without MSIX: it builds Tether.pri, from which the XAML (App.xaml and WinUI's styles) loads. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Smaller downloads: WinUI's built-in text in English only (Tether's UI is English). Trimming
         .NET breaks WinUI's interop ("No such interface supported"), so it's off. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <!-- The generated UniFFI bindings use unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK parts Tether uses: the full package also ships AI and ML runtimes
         (onnxruntime, DirectML, Search, Widgets: ~50 MB). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tether.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\icon\icon.png" Link="Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Built by build.ps1 from ../core -->
    <Content Include=".rust\$(RuntimeIdentifier)\tether_core.dll" Link="tether_core.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' != ''" />
  </ItemGroup>
</Project>
